{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": [],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@aaif/goose-sdk": ["./src/vendor/goose-sdk/index.ts"],
      "@desktop/*": ["./src/vendor/desktop/*"]
    }
  },
  "include": ["src"]
}
